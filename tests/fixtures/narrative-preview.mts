  await page.goto(`http://127.0.0.1:${port}/`); await page.getByText(ready.title, { exact: true }).first().click(); await page.getByRole("tab", { name: /逻辑与叙事/ }).click(); await page.locator(".design-workbench").waitFor();
  assert.equal(await page.locator(".narrative-story").count(), 2); assert.match(await page.locator(".design-phase").innerText(), /叙事编排/);
  await page.locator(".logic-edge").first().click(); assert.equal(await page.locator(".narrative-evidence .fact-card").count(), 2);
  await page.locator(".narrative-evidence details summary").filter({ hasText: "查看依据" }).first().click(); assert.ok(await page.locator(".narrative-evidence blockquote").first().isVisible());
  await page.locator(".narrative-story button").nth(1).click(); assert.match(await page.locator(".story-detail h3").innerText(), /回到每一年/);
  assert.equal(await page.locator(".narrative-evidence .fact-card").count(), 1);
  const previous = (await work.progress()).revision!, bad = structuredClone(good);
  bad.components[1].mapping.unit = "incorrect metric"; bad.components[3].mapping.unit = "incorrect series";
  await work.saveDraft(renderDocument("designer", bad), previous);
  const locate = page.getByRole("button", { name: `定位组件 ${bad.components[1].id}`, exact: true });
  await locate.waitFor(); await locate.click();
  assert.match(await page.locator(".story-detail h3").innerText(), /看见增长/);
  assert.ok(await page.locator(".narrative-visual").getByText("incorrect metric", { exact: false }).count());
  assert.equal(await page.locator(".design-component-status").count(), 1);
  await page.locator(".canvas-content").evaluate(element => { element.scrollTop = 0; });
  await page.waitForTimeout(2200);
  assert.equal(await page.locator(".canvas-content").evaluate(element => element.scrollTop), 0);
  await work.saveDraft(renderDocument("designer", good), (await work.progress()).revision);
  await page.waitForFunction(() => document.querySelector(".design-phase")?.textContent?.includes("预检通过"));
  assert.equal(await page.locator(".narrative-visual article").count(), 2); assert.equal(await page.locator(".narrative-story button[aria-pressed=true]").count(), 1);
  await page.locator(".canvas-content").evaluate(element => { element.scrollTop = 0; });
  await page.screenshot({ path: path.join(output, "narrative-desktop.png"), fullPage: true });
  await page.locator(".narrative-evidence").scrollIntoViewIfNeeded();
  await page.screenshot({ path: path.join(output, "narrative-evidence.png"), fullPage: true });
  await page.getByRole("button", { name: /在数据事实中定位/ }).click(); assert.equal(await page.getByRole("tab", { name: /数据事实/ }).getAttribute("aria-selected"), "true");
  await page.getByRole("tab", { name: /逻辑与叙事/ }).click();
