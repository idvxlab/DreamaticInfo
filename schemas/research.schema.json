{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "research",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": ["string", "null"]
          },
          "published_at": {
            "type": ["string", "null"]
          },
          "accessed_at": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["upload", "web"]
          },
          "path": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "published_at",
          "accessed_at",
          "kind",
          "path",
          "fields",
          "limitations"
        ]
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["id", "source_id", "path", "fields", "description"]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["summary", "sources", "datasets", "limitations"]
}
