        "analyst",
        "designer",
        "builder"
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "last_success_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "visual_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "revision",
        "issues",
        "rounds"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "unsupported",
            "needs_revision"
          ]
        },
        "revision": {
          "type": "string"
        },
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "owner",
              "component",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "enum": [
                  "researcher",
                  "analyst",
                  "designer",
                  "builder"
                ]
              },
              "component": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "concept",
                  "asset",
                  "implementation",
                  "data"
                ]
              }
            }
          }
        }
      }
    },
    "visual_sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "issues",
            "unsupported"
          ]
        },
        "checks": {
          "type": "integer",
          "minimum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "owner",
              "component",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "enum": [
                  "researcher",
                  "analyst",
                  "designer",
                  "builder"
                ]
              },
              "component": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "concept",
                  "asset",
                  "implementation",
                  "data"
                ]
              }
            }
          }
        }
      },
      "required": [
        "version",
        "scope",
        "status",
        "checks",
        "issues"
      ]
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "enum": [
            "chatbot",
            "researcher",
            "analyst",
            "designer",
            "builder"
          ]
        },
        "affected": {
          "type": "array",
          "items": {
            "enum": [
              "chatbot",
              "researcher",
              "analyst",
              "designer",
              "builder"
            ]
          }
        },
        "reason": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "affected",
        "reason",
        "at"
      ]
    }
  },
  "required": [
    "project_id",
    "status",
    "current_stage",
    "completed",
    "pending",
    "stages",
    "updated_at",
    "last_success_at",
    "error"
  ]
}
