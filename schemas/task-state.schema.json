                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "attempts"
          ]
        },
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "interrupted"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "input_hash": {
              "type": "string"
            },
            "output_hash": {
              "type": "string"
            },
