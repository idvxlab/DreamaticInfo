              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "completed_at": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "attempts"
          ]
        },
        "analyst": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "interrupted"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "input_hash": {
              "type": "string"
            },
            "output_hash": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "completed_at": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "attempts"
          ]
        },
        "designer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "completed",
                "failed",
                "interrupted"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
