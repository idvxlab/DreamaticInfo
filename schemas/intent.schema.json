{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "intent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "data_requirements": {
      "type": "string"
    },
    "story_direction": {
      "type": "string"
    },
    "visual_preferences": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "reference",
              "brand",
              "default"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement",
          "origin",
          "basis"
        ]
      }
    }
  },
  "required": [
    "title",
    "topic",
    "objective",
    "audience",
    "scope",
    "data_requirements",
    "story_direction",
    "visual_preferences",
    "constraints",
    "visual_constraints"
  ]
}
