# 搜索引擎
# 搜索服务
DREAMATIC_SEARCH_PROVIDER=auto
# 搜索 API 密钥
DREAMATIC_SEARCH_API_KEY=
# 搜索结果数量
DREAMATIC_SEARCH_RESULTS=8
# 网络请求超时（毫秒）
DREAMATIC_NETWORK_TIMEOUT_MS=25000

# 推理模型
# 提供商协议
DREAMATIC_PROVIDER_TYPE=native
# 兼容接口支持 developer 角色
DREAMATIC_SUPPORTS_DEVELOPER_ROLE=false
# 默认提供商
DREAMATIC_PROVIDER=openai
# 推理 API 地址
DREAMATIC_BASE_URL=https://api.openai.com/v1
# 推理 API 密钥
DREAMATIC_API_KEY=
# 默认推理模型
DREAMATIC_MODEL=gpt-5.4
# 连接名称
DREAMATIC_PROVIDER_NAME=
# 默认推理强度
DREAMATIC_THINKING_LEVEL=medium
# 自定义模型上下文窗口
DREAMATIC_CONTEXT_WINDOW=128000
# 自定义模型输出上限
DREAMATIC_MAX_TOKENS=8192
# 自定义模型支持推理
DREAMATIC_MODEL_REASONING=false
# ChatBot 模型
DREAMATIC_MODEL_CHATBOT=
# ChatBot 提供商
DREAMATIC_PROVIDER_CHATBOT=
# ChatBot API 地址
DREAMATIC_BASE_URL_CHATBOT=
# ChatBot API 密钥
DREAMATIC_API_KEY_CHATBOT=
# ChatBot 推理强度
DREAMATIC_THINKING_LEVEL_CHATBOT=
# Researcher 模型
DREAMATIC_MODEL_RESEARCHER=
# Researcher 提供商
DREAMATIC_PROVIDER_RESEARCHER=
# Researcher API 地址
DREAMATIC_BASE_URL_RESEARCHER=
# Researcher API 密钥
DREAMATIC_API_KEY_RESEARCHER=
# Researcher 推理强度
DREAMATIC_THINKING_LEVEL_RESEARCHER=
# Analyst 模型
DREAMATIC_MODEL_ANALYST=
# Analyst 提供商
DREAMATIC_PROVIDER_ANALYST=
# Analyst API 地址
DREAMATIC_BASE_URL_ANALYST=
# Analyst API 密钥
DREAMATIC_API_KEY_ANALYST=
# Analyst 推理强度
DREAMATIC_THINKING_LEVEL_ANALYST=
# Designer 模型
DREAMATIC_MODEL_DESIGNER=
# Designer 提供商
DREAMATIC_PROVIDER_DESIGNER=
# Designer API 地址
DREAMATIC_BASE_URL_DESIGNER=
# Designer API 密钥
DREAMATIC_API_KEY_DESIGNER=
# Designer 推理强度
DREAMATIC_THINKING_LEVEL_DESIGNER=
# Builder 模型
DREAMATIC_MODEL_BUILDER=
# Builder 提供商
DREAMATIC_PROVIDER_BUILDER=
# Builder API 地址
DREAMATIC_BASE_URL_BUILDER=
# Builder API 密钥
DREAMATIC_API_KEY_BUILDER=
# Builder 推理强度
DREAMATIC_THINKING_LEVEL_BUILDER=

# 图像模型
# 图像 API 地址
DREAMATIC_IMAGE_BASE_URL=https://api.openai.com/v1
# 图像 API 密钥
DREAMATIC_IMAGE_API_KEY=
# 图像模型
DREAMATIC_IMAGE_MODEL=gpt-image-1
# 图像生成尺寸
DREAMATIC_IMAGE_DEFAULT_SIZE=1024x1024
# 图像生成端点
DREAMATIC_IMAGE_GENERATION_ENDPOINT=
# 图像响应格式
DREAMATIC_IMAGE_RESPONSE_FORMAT=auto
# 图像响应字节上限
DREAMATIC_IMAGE_RESPONSE_MAX_BYTES=67108864
# 图像生成超时（毫秒）
DREAMATIC_IMAGE_TIMEOUT_MS=300000

# 系统参数
# 按角色配置 Skill 路径（JSON）
DREAMATIC_SKILL_PATHS=
# API 服务端口 (restart required)
PORT=4315
# 前端开发端口 (restart required)
DREAMATIC_WEB_PORT=5175
# 项目工作目录 (restart required)
DREAMATIC_WORKSPACE=./workspace/projects
# Chromium 浏览器路径（网页阅读与 PDF）
DREAMATIC_CHROME_PATH=
# 单文件上传上限（MB）
DREAMATIC_UPLOAD_LIMIT_MB=25
# 来源采集字节上限
DREAMATIC_MAX_FETCH_BYTES=5000000
# 单阶段超时（分钟）
DREAMATIC_STAGE_TIMEOUT_MINUTES=15
# 任务最大尝试次数
DREAMATIC_RETRY_ATTEMPTS=3
# 相同提交错误或修复停滞上限
DREAMATIC_MAX_REPEATED_SUBMISSIONS=3
# 连续提交失败或修复无进展上限
DREAMATIC_MAX_INVALID_SUBMISSIONS=5
# PDF 导出超时（毫秒）
DREAMATIC_PDF_TIMEOUT_MS=30000

# 调研过程
DREAMATIC_SOURCE_MIN_TEXT_CHARS=180
DREAMATIC_RESEARCH_MAX_TASKS=40
DREAMATIC_RESEARCH_REQUEST_ATTEMPTS=3

# 网页阅读器
DREAMATIC_WEB_READER=auto
DREAMATIC_WEB_READER_TIMEOUT_MS=90000
DREAMATIC_WEB_MAX_REDIRECTS=12
DREAMATIC_WEB_HTTP_TIMEOUT_MS=15000
DREAMATIC_WEB_BROWSER_READY_TIMEOUT_MS=15000
DREAMATIC_WEB_SCHOLARLY_TIMEOUT_MS=15000
DREAMATIC_WEB_BROWSER_WAIT_MS=2000
DREAMATIC_WEB_BROWSER_MAX_REQUESTS=60
DREAMATIC_WEB_BROWSER_MAX_BYTES=20000000
DREAMATIC_WEB_BROWSER_CONCURRENCY=2
