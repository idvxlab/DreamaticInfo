# Skill paths
# Skill paths
DREAMATIC_SKILL_PATHS=
# Port (restart required)
PORT=4315
# Web port (restart required)
DREAMATIC_WEB_PORT=5175
# Workspace (restart required)
DREAMATIC_WORKSPACE=./workspace/projects
# Chrome path
DREAMATIC_CHROME_PATH=
# Upload limit mb
DREAMATIC_UPLOAD_LIMIT_MB=25
# Max fetch bytes
DREAMATIC_MAX_FETCH_BYTES=5000000
# Run and stage execution budgets (minutes)
DREAMATIC_RUN_TIMEOUT_MINUTES=45
DREAMATIC_STAGE_TIMEOUT_MINUTES=15
