{
  "name": "dreamatic-info",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx apps/server/src/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@mozilla/readability": "0.6.0",
    "ajv": "^8.17.1",
    "cheerio": "^1.1.0",
    "csv-parse": "^7.0.3",
    "d3": "7.9.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "27.4.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "officeparser": "^8.1.1",
    "playwright": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tough-cookie": "6.0.2",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/express": "^5.0.3",
    "@types/jsdom": "27.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
